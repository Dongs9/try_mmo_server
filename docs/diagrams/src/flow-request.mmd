flowchart LR
    frame[onFrame] --> limit{"이번 1초에 20개 이하?"}
    limit -- 아니오 --> ignore1["무시, 구간당 1회 로그"]
    limit -- 예 --> msg{메시지 ID}
    msg -- 1000 EnterReq --> enter[handleEnter]
    msg -- 2000 MoveReq --> parse{Protobuf 해석 성공?}
    msg -- 그 외 --> ignore2[무시, 로그]
    parse -- 아니오 --> close[연결 끊기]
    parse -- 예 --> inside{맵 안 좌표?}
    inside -- 아니오 --> ignore2
    inside -- 예 --> alive{플레이어 생존?}
    alive -- 아니오 --> ignore2
    alive -- 예 --> dest["대상 해제, 목적지 저장<br/>구르기 중이면 끝난 뒤 적용"]
    msg -- 5000 SkillReq --> skill[스킬 판정: 스킬 흐름 그림 참고]
    msg -- 3000 TargetReq --> self{플레이어 생존?}
    self -- 아니오 --> ignore2
    self -- 예 --> found{"대상이 살아 있고 복귀 중 아님?"}
    found -- 아니오 --> reject[RequestRejected 전송]
    found -- 예 --> setTarget["대상 저장, 목적지 해제<br/>구르기 중이면 끝난 뒤 적용"]
