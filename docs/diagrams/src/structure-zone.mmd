classDiagram
    direction LR

    class Zone {
        -nextEntityId_
        -nextPlayerNumber_
        -tick_
        +addPlayer()
        +removePlayer(id)
        +setDestination(id, destination)
        +setTarget(id, target)
        +progressOf(id)
        +tick()
        -updatePlayers()
        -updateSlimes()
        -updateVisibility()
        -sendPositions()
    }
    class Player {
        +id
        +name
        +position
        +hp
        +level
        +maxHp
        +attack
        +defense
        +exp
        +gold
        +destination
        +target
        +nextAttackTick
        +nextRegenTick
        +reviveTick
        +visible
    }
    class Slime {
        +id
        +spawnPoint
        +position
        +hp
        +mode
        +destination
        +chaseTarget
        +nextAttackTick
        +respawnTick
        +contributions
    }
    class EntityView {
        +id
        +type
        +name
        +maxHp
        +position
        +state
    }
    class EntitySnapshot {
        +id
        +position
        +state
        +hp
        +level
    }

    Zone *-- Player : 최대 100명
    Zone *-- Slime : 30마리
    Zone ..> EntityView : 등장 때 생성
    Zone ..> EntitySnapshot : 틱마다 생성
