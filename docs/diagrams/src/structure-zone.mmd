classDiagram
    direction LR

    class Zone {
        -nextEntityId_
        -nextPlayerNumber_
        -tick_
        +addPlayer()
        +removePlayer(id)
        +setDestination(id, destination)
        +tick()
        -movePlayers()
        -updateSlimes()
        -updateVisibility()
        -sendPositions()
    }
    class Player {
        +id
        +name
        +position
        +hp
        +level
        +destination
        +visible
    }
    class Slime {
        +id
        +spawnPoint
        +position
        +hp
        +destination
        +nextWanderTick
    }
    class EntityView {
        +id
        +type
        +name
        +maxHp
        +position
        +state
    }
    class EntitySnapshot {
        +id
        +position
        +state
        +hp
        +level
    }

    Zone *-- Player : 최대 100명
    Zone *-- Slime : 30마리
    Zone ..> EntityView : 등장 때 생성
    Zone ..> EntitySnapshot : 틱마다 생성
